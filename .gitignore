# runtime data (see ACTOR_DATA_DIR / ACTOR_LOG_DIR in config.js)
# 注意：必须锚定到仓库根，否则会连 packages/data 一起忽略（真实事故，现有守卫测试兜底）
/data/
/msg_store/
*.log
dlq.jsonl
metrics.log
actor.log

# secrets
.actor-token

# deps
node_modules/

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# regenerable openssl CA state (see scripts/gen-test-certs.sh)
packages/core/test/fixtures/tls/*-db/

# 文档站产物（tools/docs-site.mjs 生成，不入库）
/site/

# 测试/脚手架生成的临时目录与临时文件（正常会被清理，进程被杀时可能残留）
.tmp-*/
.tmp-*
# 发布检查用的 npm 日志/缓存（指到工作区内，避免依赖家目录可写）
.tmp-npm/
# Node 崩溃报告（收到未处理信号时会生成）
report.*.json
