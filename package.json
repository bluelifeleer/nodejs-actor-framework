{
  "name": "nodejs-actor-framework-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root: packages/* hold the published packages, root holds the demo app, examples and integration tests.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "ci": "npm run typecheck && npm test && npm run docs:build",
    "start": "node actor-main.js",
    "gen-test-certs": "./scripts/gen-test-certs.sh",
    "typecheck:strict": "tsc -p tsconfig.json",
    "typecheck:migration": "tsc -p tsconfig.migration.json || true",
    "docs:build": "node --conditions=development tools/docs-site.mjs build",
    "docs:serve": "node --conditions=development tools/docs-site.mjs serve",
    "release:check": "node tools/release-check.mjs",
    "capabilities:freeze": "node packages/cli/src/freeze-capabilities.ts",
    "example": "node --conditions=development",
    "release:publish-dry-run": "node tools/publish-dry-run.mjs",
    "release:reserve-name": "node tools/reserve-name.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
