{
  "name": "nodejs-actor-framework-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root: packages/* hold the published packages, root holds the demo app, examples and integration tests.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 'packages/core/test/*.test.js' 'test/*.test.js'",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node actor-main.js",
    "gen-test-certs": "./scripts/gen-test-certs.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
