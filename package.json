{
  "name": "nodejs-actor-framework-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root: packages/* hold the published packages, root holds the demo app, examples and integration tests.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 'packages/cli/test/*.test.ts' 'packages/testkit/test/*.test.ts' 'packages/core/test/*.test.js' 'packages/app/test/*.test.ts' 'packages/web/test/*.test.ts' 'packages/data/test/*.test.ts' 'test/*.test.js'",
    "typecheck": "tsc -p tsconfig.json",
    "ci": "npm run typecheck && npm test && npm run docs:build",
    "start": "node actor-main.js",
    "gen-test-certs": "./scripts/gen-test-certs.sh",
    "typecheck:strict": "tsc -p tsconfig.json",
    "typecheck:migration": "tsc -p tsconfig.migration.json || true",
    "docs:build": "node tools/docs-site.mjs build",
    "docs:serve": "node tools/docs-site.mjs serve"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
