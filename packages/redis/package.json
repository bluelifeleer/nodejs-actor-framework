{
  "name": "@actor/redis",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Redis 适配器（node-redis 与 ioredis 双驱动）—— 连接管控复用 @actor/db-core",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "actor",
    "redis",
    "ioredis",
    "adapter"
  ],
  "dependencies": {
    "@actor/resource": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
