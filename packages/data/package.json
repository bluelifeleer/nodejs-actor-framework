{
  "name": "@actor/data",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Data layer for nodejs-actor-framework: schema evolution (events/snapshots), and later repositories, event-sourced aggregates, outbox and projections. Zero dependencies by design.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@actor/app": "*",
    "nodejs-actor-framework": "*"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
