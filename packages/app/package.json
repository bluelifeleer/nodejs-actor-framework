{
  "name": "@actor/app",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Application layer for nodejs-actor-framework: configuration, assembly (DI), modules and plugin SDK. User projects depend on this package, never on the kernel directly.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "nodejs-actor-framework": "*"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
