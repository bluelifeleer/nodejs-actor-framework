{
  "name": "@actor/web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Web layer for nodejs-actor-framework: routing and stateless controllers. User projects depend on @actor/app and @actor/web, never on the kernel directly.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actor/app": "*",
    "nodejs-actor-framework": "*"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
