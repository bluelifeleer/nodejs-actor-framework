{
  "name": "nodejs-actor-framework",
  "version": "1.0.0",
  "description": "Node.js Actor framework: in-process actor kernel with supervision, persistence and worker isolation, plus optional cluster/observability plugins.",
  "license": "MIT",
  "author": "bluelife <thebubblelife@163.com>",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./index.mjs",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "classic-level": "^3.0.0"
  },
  "files": [
    "src",
    "index.mjs"
  ],
  "keywords": [
    "actor",
    "actors",
    "actor-model",
    "supervision",
    "concurrency",
    "worker-threads"
  ]
}
