{
  "name": "nodejs-actor-framework",
  "version": "1.0.0",
  "description": "Node.js Actor framework: in-process actor kernel with supervision, persistence and worker isolation, plus optional cluster/observability plugins.",
  "license": "MIT",
  "author": "bluelife <thebubblelife@163.com>",
  "main": "./dist/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "development": "./index.dev.mjs",
      "import": "./index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "classic-level": "^3.0.0"
  },
  "files": [
    "dist",
    "src",
    "index.mjs",
    "index.dev.mjs"
  ],
  "keywords": [
    "actor",
    "actors",
    "actor-model",
    "supervision",
    "concurrency",
    "worker-threads"
  ],
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
