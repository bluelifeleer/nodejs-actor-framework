[ ca ]
default_ca = CA_default
[ CA_default ]
dir               = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls
database          = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca-db/index.txt
new_certs_dir     = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca-db/newcerts
certificate       = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca.crt
private_key       = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca.key
serial            = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca-db/serial
crlnumber         = /Users/lipeng/www/nodejs-actor-framework/test/fixtures/tls/ca-db/crlnumber
default_md        = sha256
default_days      = 3650
default_crl_days  = 3650
policy            = policy_any
x509_extensions   = leaf_ext
copy_extensions   = none
unique_subject    = no
[ policy_any ]
commonName        = supplied
[ leaf_ext ]
basicConstraints  = critical,CA:FALSE
keyUsage          = critical,digitalSignature,keyEncipherment
extendedKeyUsage  = serverAuth,clientAuth
subjectAltName    = DNS:localhost,IP:127.0.0.1,IP:::1
[ crl_ext ]
authorityKeyIdentifier = keyid:always
