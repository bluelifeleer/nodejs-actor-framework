{
  "name": "@actor/mongodb",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "MongoDB 适配器（官方 mongodb 驱动）+ defineCollection（索引 / $jsonSchema validator / sync 漂移检测）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "actor",
    "mongodb",
    "adapter",
    "schema"
  ],
  "dependencies": {
    "@actor/resource": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node ../../tools/build-packages.mjs --package ."
  }
}
